{
  "name": "pecule-budget",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-offline.mjs && next dev",
    "build": "node scripts/build-offline.mjs && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:e2e:connected": "node tests/e2e/connected-budget.mjs",
    "test:e2e:viewport": "node tests/e2e/mobile-viewport.mjs",
    "test:e2e:sizing": "node tests/e2e/mobile-sizing.mjs",
    "test:e2e:icons": "node tests/e2e/custom-icons.mjs",
    "test:e2e:mobile": "node tests/e2e/mobile-navigation.mjs",
    "test:e2e:signal": "node tests/e2e/available-signal.mjs",
    "test:e2e:imports": "node tests/e2e/import-recovery.mjs",
    "test:e2e:recovery": "node tests/e2e/budget-recovery.mjs",
    "test:e2e:assistance": "node tests/e2e/budget-assistance.mjs",
    "test:e2e:bank-tools": "node tests/e2e/bank-tools.mjs",
    "test:e2e:bank-tools:connected": "node tests/e2e/bank-tools-connected.mjs",
    "test:e2e:motion": "node tests/e2e/motion.mjs",
    "test:e2e:signature": "node tests/e2e/signature-interactions.mjs",
    "test:e2e:menus": "node tests/e2e/menu-motion.mjs",
    "test:e2e:sheets": "node tests/e2e/mobile-sheet.mjs",
    "test:e2e:visual": "node tests/e2e/visual-refinement.mjs",
    "test:e2e:coherence": "node tests/e2e/site-coherence.mjs",
    "test:e2e:audit-fixes": "node tests/e2e/audit-fixes.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:budget": "node --test tests/budget.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e:smooth": "node tests/e2e/smooth-motion.mjs",
    "test:e2e:global-motion": "node tests/e2e/global-motion.mjs",
    "test:e2e:harmony": "node tests/e2e/interaction-harmony.mjs",
    "test:e2e:headerless": "node tests/e2e/headerless-import.mjs",
    "test:e2e:wallet": "node tests/e2e/wallet.mjs",
    "test:e2e:design": "node tests/e2e/design-finish.mjs",
    "design:references": "node scripts/design-references.mjs",
    "design:serve-fixture": "node --import ./scripts/reference-clock.mjs node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3002",
    "assets:launch": "node scripts/generate-launch-assets.mjs",
    "test:e2e:continuity": "node tests/e2e/save-continuity.mjs",
    "test:e2e:wallet-gestures": "node tests/e2e/wallet-gestures.mjs",
    "test:e2e:typography": "node tests/e2e/typography.mjs",
    "test:e2e:editors": "node tests/e2e/financial-editors.mjs",
    "test:e2e:reflow": "node tests/e2e/desktop-reflow.mjs",
    "test:e2e:appearance": "node tests/e2e/appearance.mjs",
    "test:e2e:csp": "node tests/e2e/csp.mjs",
    "test:e2e:names": "node tests/e2e/readable-names.mjs",
    "test:e2e:savings": "node tests/e2e/savings.mjs",
    "test:e2e:checks": "node tests/e2e/budget-checks.mjs",
    "test:e2e:home": "node tests/e2e/home-layout.mjs",
    "test:e2e:statement": "node tests/e2e/statement-check.mjs",
    "format": "prettier --write \"{app,lib,tests,scripts}/**/*.{ts,tsx,mts,mjs}\"",
    "format:check": "prettier --check \"{app,lib,tests,scripts}/**/*.{ts,tsx,mts,mjs}\"",
    "install:ci": "npm ci --include=dev --include=optional"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "^0.81.0",
    "better-auth": "1.7.28",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "axe-core": "4.11.4",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "playwright": "1.64.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "baseline-browser-mapping": "^2.11.34",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "fflate": "^0.8.3"
  }
}
